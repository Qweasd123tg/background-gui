[Unit]
Description=Niri with AgentInput and desktop pointer (separate test session)
BindsTo=graphical-session.target
Before=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
Wants=xdg-desktop-autostart.target
Before=xdg-desktop-autostart.target

[Service]
Slice=session.slice
Type=notify
ExecCondition=/usr/bin/sh -c '! /usr/bin/systemctl --user --quiet is-active niri.service'
ExecStart=%h/.local/lib/background-gui-host/current/bin/niri --session --config %h/.config/niri/agent-input.kdl
