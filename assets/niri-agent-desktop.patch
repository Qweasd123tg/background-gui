+/// Each window batch ends with balanced input, so another agent can run immediately.
+fn validate_window_batch(events: &[AgentEvent]) -> Result<(), String> {
+    use std::collections::HashSet;
+    if events.len() > 512 {
+        return Err("split window input into smaller batches".into());
+    }
+    let mut held = HashSet::new();
+    let mut moved = false;
+    for event in events {
+        match event {
+            AgentEvent::Motion { x, y } if x.is_finite() && y.is_finite() => moved = true,
+            AgentEvent::Axis { vertical, horizontal } if moved && vertical.is_finite() && horizontal.is_finite() => (),
+            AgentEvent::Text { text, .. } if text.len() <= 16384 && held.is_empty() => (),
+            AgentEvent::Button { button, pressed } if moved && (272..=279).contains(button) => {
+                if *pressed { held.insert((true, *button)); } else if !held.remove(&(true, *button)) {
+                    return Err("button release without press".into());
+                }
+            }
+            AgentEvent::Key { keycode, pressed } if *keycode <= 767 => {
+                if *pressed { held.insert((false, *keycode)); } else if !held.remove(&(false, *keycode)) {
+                    return Err("key release without press".into());
+                }
+            }
+            _ => return Err("invalid window input batch".into()),
+        }
+    }
+    if !held.is_empty() { return Err("release held input in the same batch".into()); }
+    Ok(())
+}
