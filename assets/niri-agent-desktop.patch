index 0000000..23bbe34
--- /dev/null
+++ b/src/agent_input/arrow.rs
@@ -0,0 +1,85 @@
+use std::time::Instant;
+
+use pangocairo::cairo::{Context, Format, ImageSurface, LineJoin};
+use smithay::backend::allocator::Fourcc;
+use smithay::backend::renderer::element::memory::{
+    MemoryRenderBuffer, MemoryRenderBufferRenderElement,
+};
+use smithay::backend::renderer::element::Kind;
+use smithay::utils::{Logical, Physical, Point, Scale, Transform};
+
+use super::AgentCursor;
+use crate::render_helpers::renderer::NiriRenderer;
+
+// Rasterize once at 3x so the same outline stays crisp on fractional-scale outputs.
+// Tip in logical coordinates, including padding around its stroke.
+const TIP: (f64, f64) = (2.5, 2.5);
+
+const COLORS: [(f64, f64, f64); 4] = [(0.57, 0.36, 1.), (0.08, 0.72, 0.69), (0.95, 0.35, 0.51), (0.24, 0.62, 1.)];
+
+fn draw_arrow(color: (f64, f64, f64)) -> MemoryRenderBuffer {
+    let mut surface = ImageSurface::create(Format::ARgb32, 90, 114).unwrap();
+    {
+        let ctx = Context::new(&surface).unwrap();
+        ctx.scale(3., 3.);
+        ctx.move_to(TIP.0, TIP.1);
+        for (x, y) in [
+            (24., 19.),
+            (14., 20.),
+            (19., 31.),
+            (13., 34.),
+            (8., 23.),
+            (2.5, 30.),
+        ] {
+            ctx.line_to(x, y);
+        }
+        ctx.close_path();
+        ctx.set_line_join(LineJoin::Round);
+        ctx.set_source_rgb(0.13, 0.08, 0.22);
+        ctx.set_line_width(4.);
+        ctx.stroke_preserve().unwrap();
+        ctx.set_source_rgb(1., 1., 1.);
+        ctx.set_line_width(2.);
+        ctx.stroke_preserve().unwrap();
+        ctx.set_source_rgb(color.0, color.1, color.2);
+        ctx.fill().unwrap();
+    }
+    let data = surface.data().unwrap();
+    MemoryRenderBuffer::from_slice(
+        &data,
+        Fourcc::Argb8888,
+        (90, 114),
+        3,
+        Transform::Normal,
+        None,
+    )
+}
+
+thread_local! {
+    static ARROWS: [MemoryRenderBuffer; 4] = COLORS.map(draw_arrow);
+}
+
+impl AgentCursor {
+    pub fn arrow<R: NiriRenderer>(
+        &self,
+        renderer: &mut R,
+        origin: Point<f64, Logical>,
+        scale: Scale<f64>,
+    ) -> Option<MemoryRenderBufferRenderElement<R>> {
+        let pos: Point<f64, Physical> = (origin + self.position(Instant::now()) - Point::from(TIP))
+            .to_physical_precise_round(scale);
+        ARROWS.with(|arrows| {
+            let buf = &arrows[usize::from(self.color) % arrows.len()];
+            MemoryRenderBufferRenderElement::from_buffer(
+                renderer,
+                pos,
+                buf,
+                None,
+                None,
+                None,
+                Kind::Cursor,
+            )
+            .ok()
+        })
+    }
+}
